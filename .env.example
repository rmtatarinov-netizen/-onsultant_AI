# --- Telegram: два разных токена от BotFather ---
BOT_TOKEN_SHORT=123456789:AA...short_bot_token
BOT_TOKEN_LONG=123456789:AA...long_bot_token
# TELEGRAM_PROXY=http://127.0.0.1:12334

# --- OpenAI-совместимый API ---
OPENAI_API_KEY=sk-...your_api_key
OPENAI_BASE_URL=https://api.proxyapi.ru/v1
OPENAI_MODEL=gpt-4o-mini

# fallback-имена для совместимости со старым проектом:
# PROXYAPI_API_KEY=
# PROXYAPI_BASE_URL=
# CHAT_MODEL=

# --- Память и логирование ---
MEMORY_PAIRS=10
THESIS_LIMIT=30
DB_PATH=/app/data/consultant.db
LOG_LEVEL=INFO
# LOG_FILE=/app/logs/consultant.log
